# Copia a .env y rellena. Nunca subas el .env de verdad.

# bot de avisos (crea uno con @BotFather) y chat al que avisa
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Transmission, para el fallback de nyaa.si (vacío si no tiene contraseña)
TRANSMISSION_USER=
TRANSMISSION_PASS=

# requester-bot: a dónde enviar los avisos por capítulo (vacío = desactivado)
REQUESTER_CALLBACK_URL=
REQUESTER_CALLBACK_SECRET=

# bot de administración (puede ser otro bot). Chats autorizados separados por comas
ADMIN_BOT_TOKEN=
ADMIN_BOT_CHAT_IDS=
